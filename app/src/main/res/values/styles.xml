<resources>
    <style name="CalcBtn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/btn_normal</item>
        <item name="android:textColor">#EDEDED</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="OpBtn" parent="CalcBtn">
        <item name="android:background">@drawable/btn_operator</item>
    </style>

    <style name="EqBtn" parent="CalcBtn">
        <item name="android:background">@drawable/btn_equal</item>
        <item name="android:textColor">#000000</item>
    </style>
</resources>
