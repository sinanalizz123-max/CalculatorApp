<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Display -->
    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.35"
        android:gravity="end|bottom"
        android:padding="24dp"
        android:text="0"
        android:textSize="36sp"
        android:textColor="@color/text_primary" />

    <!-- Buttons -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.65"
        android:columnCount="4"
        android:rowCount="5"
        android:useDefaultMargins="true"
        android:padding="12dp">

        <!-- Row 1 -->
        <Button style="@style/CalcBtn" android:text="AC"/>
        <Button style="@style/CalcBtn" android:text="%"/>
        <Button style="@style/CalcBtn" android:text="÷"/>
        <Button style="@style/CalcBtn" android:text="⌫"/>

        <!-- Row 2 -->
        <Button style="@style/CalcBtn" android:text="7"/>
        <Button style="@style/CalcBtn" android:text="8"/>
        <Button style="@style/CalcBtn" android:text="9"/>
        <Button style="@style/OpBtn" android:text="×"/>

        <!-- Row 3 -->
        <Button style="@style/CalcBtn" android:text="4"/>
        <Button style="@style/CalcBtn" android:text="5"/>
        <Button style="@style/CalcBtn" android:text="6"/>
        <Button style="@style/OpBtn" android:text="−"/>

        <!-- Row 4 -->
        <Button style="@style/CalcBtn" android:text="1"/>
        <Button style="@style/CalcBtn" android:text="2"/>
        <Button style="@style/CalcBtn" android:text="3"/>
        <Button style="@style/OpBtn" android:text="+"/>

        <!-- Row 5 -->
        <Button
            style="@style/CalcBtn"
            android:text="0"
            android:layout_columnSpan="2"/>

        <Button style="@style/CalcBtn" android:text="."/>
        <Button style="@style/EqBtn" android:text="="/>

    </GridLayout>

</LinearLayout>
